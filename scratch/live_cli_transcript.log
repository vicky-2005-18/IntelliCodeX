import pytest
from calculator_practice import add, subtract, multiply, divide

def test_add_happy_path():
    # Grounded in: Happy path for addition
    assert add(2, 3) == 5

def test_add_edge_case_negative_numbers():
    # Grounded in: Edge case with negative numbers
    assert add(-1, -1) == -2

def test_subtract_happy_path():
    # Grounded in: Happy path for subtraction
    assert subtract(5, 3) == 2

def test_subtract_asymmetric_inputs():
    # Grounded in: Asymmetric inputs for subtraction
    assert subtract(3, 5) != subtract(5, 3)

def test_multiply_happy_path():
    # Grounded in: Happy path for multiplication
    assert multiply(4, 3) == 12

def test_divide_true_float_division():
    # Grounded in: True float division
    assert divide(5, 2) == 2.5

def test_divide_integer_floor_division():
    # Grounded in: Integer floor division
    assert divide(5, 2) != 2

def test_divide_by_zero_exception():
    # Grounded in: Expected exception on division by zero
    with pytest.raises(ZeroDivisionError):
        divide(5, 0)

def test_divide_asymmetric_inputs():
    # Grounded in: Asymmetric inputs for division
    assert divide(3, 2) != divide(2, 3)

def test_subtract_edge_case_negative_numbers():
    # Grounded in: Edge case with negative numbers
    assert subtract(-1, -5) == 4

def test_multiply_edge_case_zero():
    # Grounded in: Edge case with zero multiplication
    assert multiply(0, 5) == 0

def test_divide_edge_case_large_numbers():
    # Grounded in: Edge case with large numbers
    assert divide(123456789, 987654321) == pytest.approx(0.0124937418)

